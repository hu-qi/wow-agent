# Copy this file to `.env` and fill in the values you need.
# Do not commit your real `.env` file or real API keys.

# OpenAI or OpenAI-compatible providers
OPENAI_API_KEY=your_openai_api_key_here
# OPENAI_BASE_URL=https://api.openai.com/v1
# OPENAI_BASE_URL=https://your-compatible-endpoint/v1

# Zishu / OpenAI-compatible endpoint used by some tutorial examples
ZISHU_API_KEY=your_zishu_api_key_here
# ZISHU_BASE_URL=http://101.132.164.17:8000/v1
# ZISHU_CHAT_MODEL=glm-4-flash
# ZISHU_EMBED_MODEL=embedding-3

# ZhipuAI examples
ZHIPU_API_KEY=your_zhipu_api_key_here

# Bocha Web Search examples
BOCHA_API_KEY=your_bocha_api_key_here

# Local Ollama examples
# Most local examples can use http://127.0.0.1:11434
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_CHAT_MODEL=qwen2.5:7b
OLLAMA_EMBED_MODEL=qwen2.5:7b
